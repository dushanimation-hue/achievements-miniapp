# === Локальная разработка (SQLite) ===
DATABASE_URL="file:./db/custom.db"

# === Vercel Postgres (для деплоя) ===
# Раскомментируй эти строки и удали SQLite строку выше при деплое на Vercel:
# DATABASE_URL="postgresql://default:xxxxx@ep-xxxxx.us-east-2.aws.neon.tech/verceldb?sslmode=require"
# DIRECT_URL="postgresql://default:xxxxx@ep-xxxxx.us-east-2.aws.neon.tech/verceldb?sslmode=require"
#
# Также поменяй в prisma/schema.prisma:
#   provider = "postgresql"   (вместо "sqlite")
#   directUrl = env("DIRECT_URL")  (добавь эту строку)
