generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  telegramId   String   @unique
  login        String?  @unique
  password     String?
  name         String
  username     String?
  avatarUrl    String?
  role         String   @default("STUDENT")
  facultyId    String?
  faculty      Faculty? @relation(fields: [facultyId], references: [id])
  totalXp      Int      @default(0)
  level        Int      @default(1)
  league       String   @default("bronze")
  statusEmoji  String   @default("")
  statusPrefix String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  achievements          Achievement[]
  userBadges            UserBadge[]
  challengeParticipations ChallengeParticipant[]
  reviewedAchievements  Achievement[] @relation("ReviewedAchievements")
}

model Faculty {
  id        String @id @default(cuid())
  name      String
  emoji     String
  color     String
  users     User[]

  @@map("faculties")
}

model Achievement {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  title          String
  description    String?
  category       String
  direction      String?
  achievementType  String?  @default("SPORT")
  achievementLevel String?  @default("SCHOOL")
  placement      Int?     @default(1)
  xpRequested    Int
  xpAwarded      Int      @default(0)
  status         String   @default("PENDING")
  fileUrl        String?
  achievementDate String?
  comment        String?
  reviewComment  String?
  reviewedBy     String?
  reviewer       User?    @relation("ReviewedAchievements", fields: [reviewedBy], references: [id])
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  achievementBadges AchievementBadge[]

  @@map("achievements")
}

model Badge {
  id             String @id @default(cuid())
  name           String
  description    String
  emoji          String
  conditionType  String
  conditionValue Int
  userBadges     UserBadge[]
  achievementBadges AchievementBadge[]

  @@map("badges")
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  user      User     @relation(fields: [userId], references: [id])
  badge     Badge    @relation(fields: [badgeId], references: [id])
  earnedAt  DateTime @default(now())

  @@unique([userId, badgeId])
  @@map("user_badges")
}

model AchievementBadge {
  id            String @id @default(cuid())
  achievementId String
  badgeId       String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  badge         Badge      @relation(fields: [badgeId], references: [id])

  @@map("achievement_badges")
}

model Challenge {
  id          String   @id @default(cuid())
  title       String
  description String
  direction   String
  xpTarget    Int
  rewardXp    Int
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  participants ChallengeParticipant[]

  @@map("challenges")
}

model ChallengeParticipant {
  id          String    @id @default(cuid())
  userId      String
  challengeId String
  user        User      @relation(fields: [userId], references: [id])
  challenge   Challenge @relation(fields: [challengeId], references: [id])
  xpCollected Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?

  @@unique([userId, challengeId])
  @@map("challenge_participants")
}
